meta {
  name: todos list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/todos
  body: none
  auth: none
}

headers {
  Token: {{token}}
}

tests {
  test("200 OK", function() { expect(res.getStatus()).to.equal(200); });
  test("has todos array", function() { expect(res.getBody().todos).to.be.an("array"); });
}
