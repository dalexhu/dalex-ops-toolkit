meta {
  name: todo get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/todos/{{todoId}}
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("todoId")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

tests {
  test("200 OK", function() { expect(res.getStatus()).to.equal(200); });
}
