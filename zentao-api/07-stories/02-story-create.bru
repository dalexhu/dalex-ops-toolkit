meta {
  name: story create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/products/{{productId}}/stories
  body: json
  auth: none
}

headers {
  Token: {{token}}
}

body:json {
  {
    "title": "{{prefix}} bruno story {{$timestamp}}",
    "spec": "<p>created by the bruno api test, safe to delete</p>",
    "pri": 3,
    "category": "feature",
    "reviewer": ["{{account}}"]
  }
}

script:post-response {
  if ((res.getStatus() === 201 || res.getStatus() === 200) && res.getBody().id) bru.setVar("storyId", res.getBody().id);
}

tests {
  test("created with id (201, or 200 when the story enters review)", function() { expect([200, 201]).to.include(res.getStatus()); expect(Number(res.getBody().id)).to.be.above(0); });
}

docs {
  必填：title, spec, pri, category；产品若强制评审还要 reviewer（数组），否则 400『评审人不能为空』。
}
