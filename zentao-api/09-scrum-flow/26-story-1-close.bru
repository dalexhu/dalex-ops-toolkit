meta {
  name: 20 story 1 close (done)
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/stories/{{flowStory1Id}}/close
  body: json
  auth: none
}

script:pre-request {
  if (!bru.getVar("flowStory1Id")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

body:json {
  {
    "closedReason": "done",
    "comment": "delivered in sprint 1"
  }
}

tests {
  test("200", function() { expect(res.getStatus()).to.equal(200); });
  test("closed", function() { expect(res.getBody().status).to.equal("closed"); });
}
