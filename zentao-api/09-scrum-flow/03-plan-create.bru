meta {
  name: 3 product plan create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/products/{{flowProductId}}/plans
  body: json
  auth: none
}

headers {
  Token: {{token}}
}

body:json {
  {
    "title": "{{prefix}} scrum sprint-1 plan",
    "begin": "2026-09-08",
    "end": "2026-09-19",
    "desc": "backlog for sprint 1"
  }
}

script:post-response {
  if (res.getBody() && res.getBody().id) bru.setVar("flowPlanId", res.getBody().id);
}

tests {
  test("flowPlanId created", function() { expect([200, 201]).to.include(res.getStatus()); expect(Number(res.getBody().id)).to.be.above(0); });
}
