meta {
  name: 18 testcase create
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/products/{{flowProductId}}/testcases
  body: json
  auth: none
}

headers {
  Token: {{token}}
}

body:json {
  {
    "title": "{{prefix}} scrum case: login works",
    "type": "feature",
    "pri": 2,
    "stage": "unittest",
    "story": "{{flowStory1Id}}",
    "precondition": "user exists",
    "steps": [
      {
        "desc": "open login page",
        "expect": "page shows"
      },
      {
        "desc": "submit valid credentials",
        "expect": "redirected to dashboard"
      }
    ]
  }
}

script:post-response {
  if (res.getBody() && res.getBody().id) bru.setVar("flowCaseId", res.getBody().id);
}

tests {
  test("flowCaseId created", function() { expect([200, 201]).to.include(res.getStatus()); expect(Number(res.getBody().id)).to.be.above(0); });
}
