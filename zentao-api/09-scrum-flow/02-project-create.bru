meta {
  name: 2 project create (scrum)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: none
}

headers {
  Token: {{token}}
}

body:json {
  {
    "name": "{{prefix}} scrum project {{$timestamp}}",
    "model": "scrum",
    "begin": "2026-09-08",
    "end": "2026-10-30",
    "products": [
      "{{flowProductId}}"
    ],
    "PM": "{{account}}",
    "acl": "private"
  }
}

script:post-response {
  if (res.getBody() && res.getBody().id) bru.setVar("flowProjectId", res.getBody().id);
}

tests {
  test("flowProjectId created", function() { expect([200, 201]).to.include(res.getStatus()); expect(Number(res.getBody().id)).to.be.above(0); });
  test("model is scrum", function() { expect(res.getBody().model).to.equal("scrum"); });
}
