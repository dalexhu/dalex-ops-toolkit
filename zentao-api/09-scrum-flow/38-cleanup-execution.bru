meta {
  name: cleanup execution
  type: http
  seq: 38
}

delete {
  url: {{baseUrl}}/executions/{{flowExecutionId}}
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("flowExecutionId")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

script:post-response {
  bru.setVar("flowExecutionId", "");
}

tests {
  test("200", function() { expect(res.getStatus()).to.equal(200); });
}
