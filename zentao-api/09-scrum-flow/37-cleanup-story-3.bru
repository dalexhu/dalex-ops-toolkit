meta {
  name: cleanup story 3
  type: http
  seq: 37
}

delete {
  url: {{baseUrl}}/stories/{{flowStory3Id}}
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("flowStory3Id")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

script:post-response {
  bru.setVar("flowStory3Id", "");
}

tests {
  test("200", function() { expect(res.getStatus()).to.equal(200); });
}
