meta {
  name: cleanup product
  type: http
  seq: 41
}

delete {
  url: {{baseUrl}}/products/{{flowProductId}}
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("flowProductId")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

script:post-response {
  bru.setVar("flowProductId", "");
}

tests {
  test("200", function() { expect(res.getStatus()).to.equal(200); });
}
