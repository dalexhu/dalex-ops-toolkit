meta {
  name: 13 build create
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/projects/{{flowProjectId}}/builds
  body: json
  auth: none
}

script:pre-request {
  if (!bru.getVar("flowExecutionId")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

body:json {
  {
    "execution": "{{flowExecutionId}}",
    "product": "{{flowProductId}}",
    "name": "sprint1-build-1",
    "builder": "{{account}}",
    "date": "2026-09-11",
    "desc": "first build of sprint 1"
  }
}

script:post-response {
  if (res.getBody() && res.getBody().id) bru.setVar("flowBuildId", res.getBody().id);
}

tests {
  test("flowBuildId created", function() { expect([200, 201]).to.include(res.getStatus()); expect(Number(res.getBody().id)).to.be.above(0); });
}
