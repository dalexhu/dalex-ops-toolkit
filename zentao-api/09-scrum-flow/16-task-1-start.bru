meta {
  name: 10 task 1 start
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/tasks/{{flowTask1Id}}/start
  body: json
  auth: none
}

script:pre-request {
  if (!bru.getVar("flowTask1Id")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

body:json {
  {
    "assignedTo": "{{account}}",
    "consumed": 1,
    "left": 3,
    "realStarted": "2026-09-08 09:00:00",
    "comment": "started"
  }
}

tests {
  test("200", function() { expect(res.getStatus()).to.equal(200); });
  test("doing", function() { expect(res.getBody().status).to.equal("doing"); });
}
