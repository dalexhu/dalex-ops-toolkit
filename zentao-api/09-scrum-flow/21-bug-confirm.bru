meta {
  name: 15 bug confirm
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/bugs/{{flowBugId}}/confirm
  body: json
  auth: none
}

script:pre-request {
  if (!bru.getVar("flowBugId")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

body:json {
  {
    "assignedTo": "{{account}}",
    "pri": 2,
    "comment": "confirmed"
  }
}

tests {
  test("200", function() { expect(res.getStatus()).to.equal(200); });
  test("confirmed", function() { expect(String(res.getBody().confirmed)).to.match(/^(1|true)$/); });
}
