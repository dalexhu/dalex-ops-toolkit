meta {
  name: 6 submit results: all pass
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/testcases/{{tcCaseId}}/results
  body: json
  auth: none
}

script:pre-request {
  if (!bru.getVar("tcCaseId")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

body:json {
  {
    "steps": [
      {
        "result": "pass",
        "real": "表单正常显示"
      },
      {
        "result": "pass",
        "real": "已跳转首页"
      }
    ]
  }
}

tests {
  test("200", function() { expect(res.getStatus()).to.equal(200); });
}
