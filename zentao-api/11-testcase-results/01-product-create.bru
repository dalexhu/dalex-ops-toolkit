meta {
  name: 1 product for the case
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

headers {
  Token: {{token}}
}

body:json {
  {
    "name": "{{prefix}} tc product {{$timestamp}}",
    "PO": "{{account}}",
    "QD": "{{account}}",
    "RD": "{{account}}",
    "type": "normal",
    "desc": "testcase result loop, safe to delete"
  }
}

script:post-response {
  if (res.getBody().id) bru.setVar("tcProductId", res.getBody().id);
}

tests {
  test("created", function() { expect([200,201]).to.include(res.getStatus()); expect(Number(res.getBody().id)).to.be.above(0); });
}

docs {
  每轮自建一个产品，跑完删除，不碰真实用例。
}
