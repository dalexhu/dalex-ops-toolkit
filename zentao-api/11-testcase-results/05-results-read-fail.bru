meta {
  name: 5 read back: case result is fail
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/testcases/{{tcCaseId}}/results
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("tcCaseId")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

tests {
  test("200", function() { expect(res.getStatus()).to.equal(200); });
  test("latest run is fail, steps recorded", function() {
    const r = (res.getBody().results || [])[0];
    expect(r, "no result rows").to.be.an("object");
    expect(r.caseResult).to.equal("fail");
    const sr = r.stepResults || [];
    expect(sr.length).to.equal(2);
    expect(sr[0].result).to.equal("pass");
    expect(sr[1].result).to.equal("fail");
    expect(String(sr[1].real)).to.include("500");
  });
}
