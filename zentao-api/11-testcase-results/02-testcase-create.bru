meta {
  name: 2 testcase with two steps
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/products/{{tcProductId}}/testcases
  body: json
  auth: none
}

script:pre-request {
  if (!bru.getVar("tcProductId")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

body:json {
  {
    "title": "{{prefix}} login case {{$timestamp}}",
    "type": "feature",
    "pri": 2,
    "stage": "unittest",
    "precondition": "账号已存在",
    "steps": [
      {
        "desc": "打开登录页",
        "expect": "显示登录表单"
      },
      {
        "desc": "输入正确的账号密码并提交",
        "expect": "跳转到首页"
      }
    ]
  }
}

script:post-response {
  if (res.getBody().id) bru.setVar("tcCaseId", res.getBody().id);
}

tests {
  test("created", function() { expect([200,201]).to.include(res.getStatus()); expect(Number(res.getBody().id)).to.be.above(0); });
}
