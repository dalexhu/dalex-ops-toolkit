meta {
  name: v2 execution stories
  type: http
  seq: 6
}

get {
  url: {{v2BaseUrl}}/executions/{{v2ExecutionId}}/stories
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("v2ExecutionId")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

tests {
  test("200", function() { expect(res.getStatus()).to.equal(200); });
  test("status success", function() { expect(res.getBody().status).to.equal("success"); });
  test("stories array with pager", function() { expect(res.getBody().stories).to.be.an("array"); const p = res.getBody().pager; expect(p).to.be.an("object"); expect(Number(p.recTotal)).to.be.at.least(0); });
}

docs {
  只读。v2 没有关联/解除需求的入口（路由表里该地址只有 GET），写操作仍要走 v1。
}
