meta {
  name: bugs list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/products/{{productId}}/bugs
  body: none
  auth: none
}

headers {
  Token: {{token}}
}

tests {
  test("200 OK", function() { expect(res.getStatus()).to.equal(200); });
  test("has bugs array", function() { expect(res.getBody().bugs).to.be.an("array"); });
}
