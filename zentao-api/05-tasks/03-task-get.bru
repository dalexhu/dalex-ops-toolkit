meta {
  name: task get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/tasks/{{taskId}}
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("taskId")) bru.runner.skipRequest();
}

headers {
  Token: {{token}}
}

tests {
  test("200 OK", function() { expect(res.getStatus()).to.equal(200); });
  test("deadline unchanged (no time zone shift)", function() { expect(res.getBody().deadline).to.equal("2026-09-16"); });
}
