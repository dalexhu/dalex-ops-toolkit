meta {
  name: projects list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/projects
  body: none
  auth: none
}

headers {
  Token: {{token}}
}

script:post-response {
  const items = res.getBody().projects || [];
  const hit = items.find(x => x.status === "doing") || items[0];
  if (hit && !bru.getVar("projectId")) bru.setVar("projectId", hit.id);
}

tests {
  test("200 OK", function() { expect(res.getStatus()).to.equal(200); });
  test("has projects array", function() { expect(res.getBody().projects).to.be.an("array"); });
}
