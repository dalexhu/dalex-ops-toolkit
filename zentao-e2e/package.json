{
  "name": "zentao-e2e",
  "version": "1.0.0",
  "description": "禅道用例 → Playwright 前端自动化 → 结果回写禅道",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "npm run test:api && npm run test:ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "export": "node scripts/export-cases.mjs",
    "push": "node scripts/push-results.mjs",
    "push:write": "node scripts/push-results.mjs --write",
    "test:ui": "PLAYWRIGHT_JSON_OUTPUT_NAME=reports/results-ui.json playwright test --project=ui",
    "test:api": "PLAYWRIGHT_JSON_OUTPUT_NAME=reports/results-api.json playwright test --project=api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "dotenv": "^17.4.2"
  }
}
