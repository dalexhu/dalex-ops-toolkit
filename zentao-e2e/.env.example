# 禅道（83 演练实例；换成 75 现网时改 baseUrl）
ZENTAO_URL=http://192.0.2.12:8080/api.php/v1
# 建议用专门的自动化账号，别用个人账号（登录失败会累计禅道的锁定计数）
ZENTAO_ACCOUNT=e2e_test
ZENTAO_PASSWORD=
ZENTAO_PRODUCT=3

# 被测前端（test2 / 87）
TERRA_URL=http://zentao.example.internal
# 把 vhost 名解析到内网 IP（nginx 的 /api 反代挂在 server_name 上，直连 :8282 只有静态文件）
TERRA_HOST_MAP=zentao.example.internal 192.0.2.13
TERRA_USER=
TERRA_PASSWORD=
TERRA_EMAIL=test@ops.ca
# 用例点名的 VWP 仪器
TERRA_INSTRUMENT=VP26-AEP Pond-BH-20260615210219670
# Abnormal Condition 只有 Outtake Drain 类型的表单才有
TERRA_INSTRUMENT_OUTTAKE=OD_20250910_1
# 有历史读数的仪器（VMP-READING-014 要求 Reading History 非空）
TERRA_INSTRUMENT_WITH_HISTORY=DP11-58
# QC Alarm 用的 SMM 仪器（要有 asBuiltTipElevation / asBuiltGroundElevation）
TERRA_SMM_INSTRUMENT=SMM_20250915_1
# API 用例的入口，留空则用 TERRA_URL（必须是域名，nginx 按 server_name 匹配 /api）
TERRA_API_URL=
# Version 1 站点（VMP-READING-V1-00x 用；没配则这两条跳过）
TERRA_V1_URL=
TERRA_V1_USER=
TERRA_V1_PASSWORD=

# 回写结果时挂到哪个测试单（可留空，留空则只写用例结果不挂单）
ZENTAO_TESTTASK=
